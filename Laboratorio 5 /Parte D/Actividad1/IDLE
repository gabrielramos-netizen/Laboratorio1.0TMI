#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <avr/sleep.h>
#include <util/delay.h>

// Bandera que indica que ocurrió una interrupción
volatile uint8_t despertar = 0;

// Interrupción externa INT0
ISR(INT0_vect)
{
	despertar = 1;
}

int main(void)
{


	DDRB |= (1 << PB0);

	// LED apagado
	PORTB &= ~(1 << PB0);



	// PD2 como entrada
	DDRD &= ~(1 << PD2);

	// Activar resistencia pull-up interna
	PORTD |= (1 << PD2);


//interrupcion

	// INT0 se activa por flanco descendente
	EICRA &= ~(1 << ISC00);
	EICRA |= (1 << ISC01);

	// Limpiar bandera pendiente
	EIFR |= (1 << INTF0);

	// Habilitar interrupción INT0
	EIMSK |= (1 << INT0);

	// Habilitar interrupciones globales
	sei();


//modo idle

	set_sleep_mode(SLEEP_MODE_IDLE);



while (1)
{
	// Esperar a que el pulsador esté suelto
	while (!(PIND & (1 << PD2)))
	{
	}

	_delay_ms(20);

	// Preparar entrada en Sleep
	cli();

	despertar = 0;

	// Limpiar una interrupción pendiente
	EIFR |= (1 << INTF0);

	sleep_enable();

	// Habilitar interrupciones
	sei();

	// Entrar en modo Idle
	sleep_cpu();

	// Al despertar, deshabilitar Sleep
	sleep_disable();

	if (despertar)
	{
		_delay_ms(20);

		if (!(PIND & (1 << PD2)))
		{
			// Encender LED
			PORTB |= (1 << PB0);

			// Esperar liberación del pulsador
			while (!(PIND & (1 << PD2)))
			{
			}

			_delay_ms(20);

			// Apagar LED
			PORTB &= ~(1 << PB0);
		}
	}
}

}
