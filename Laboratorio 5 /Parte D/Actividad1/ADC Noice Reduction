
#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <avr/sleep.h>
#include <util/delay.h>

volatile uint8_t conversion_lista = 0;

// Interrupcion cuando termina la conversion ADC
ISR(ADC_vect)
{
	conversion_lista = 1;
}

int main(void)
{

	DDRB |= (1 << PB0);
	PORTB &= ~(1 << PB0);

	// Configurar ADC:
	ADMUX = (1 << REFS0);

	// Habilitar ADC, interrupcion ADC y prescaler 128
	ADCSRA = (1 << ADEN) |
	(1 << ADIE) |
	(1 << ADPS2) |
	(1 << ADPS1) |
	(1 << ADPS0);

	// Seleccionar modo ADC Noise Reduction
	set_sleep_mode(SLEEP_MODE_ADC);

	sei();

	while (1)
	{
		conversion_lista = 0;

		// Iniciar conversion y entrar en reposo
		cli();

		ADCSRA |= (1 << ADSC);

		sleep_enable();

		sei();
		sleep_cpu();

		sleep_disable();

		// El ADC ya termino y desperto al microcontrolador
		if (conversion_lista)
		{
			PORTB ^= (1 << PB0);
			_delay_ms(500);
		}
	}
}
