#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <avr/sleep.h>
#include <util/delay.h>

// 0 = IDLE
// 1 = ADC NOISE REDUCTION
// 2 = POWER-DOWN
#define MODO_SLEEP 0

volatile uint8_t despertar = 0;

ISR(INT0_vect)
{
	despertar = 1;

#if MODO_SLEEP == 2
	// INT0 por nivel: se deshabilita hasta volver a dormir,
	// si no la ISR se repite mientras el pulsador siga en bajo
	EIMSK &= ~(1 << INT0);
#endif
}

ISR(ADC_vect)
{
	despertar = 1;
}

int main(void)
{
	// LED en PB0 como salida
	DDRB |= (1 << PB0);
	PORTB &= ~(1 << PB0);

	// Ventana inicial de 1,5 s para poder reprogramar
	for (uint8_t i = 0; i < 6; i++) {
		PORTB ^= (1 << PB0);
		_delay_ms(250);
	}
	PORTB &= ~(1 << PB0);

#if MODO_SLEEP == 0
	// IDLE: INT0 por flanco descendente
	DDRD &= ~(1 << PD2);
	PORTD |= (1 << PD2);

	EICRA &= ~(1 << ISC00);
	EICRA |= (1 << ISC01);
	EIFR = (1 << INTF0);
	EIMSK |= (1 << INT0);

	set_sleep_mode(SLEEP_MODE_IDLE);

#elif MODO_SLEEP == 1
	// ADC NOISE REDUCTION
	DDRB |= (1 << PB1);          // pin de prueba (referencia del osciloscopio)
	PORTB &= ~(1 << PB1);

	ADMUX = (1 << REFS0);        // AVcc, canal ADC0
	ADCSRA = (1 << ADEN) | (1 << ADIE) |
	         (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);   // prescaler 128

	set_sleep_mode(SLEEP_MODE_ADC);

#elif MODO_SLEEP == 2
	// POWER-DOWN: INT0 por nivel bajo
	DDRD &= ~(1 << PD2);
	PORTD |= (1 << PD2);

	EICRA &= ~((1 << ISC01) | (1 << ISC00));
	EIFR = (1 << INTF0);
	EIMSK |= (1 << INT0);

	set_sleep_mode(SLEEP_MODE_PWR_DOWN);

#else
#error "Seleccion de modo Sleep incorrecta"
#endif

	sei();

	while (1)
	{
		despertar = 0;

#if MODO_SLEEP == 0 || MODO_SLEEP == 2

		// Dormir SOLO con el pulsador suelto (nivel alto)
		while (!(PIND & (1 << PD2))) {}
		_delay_ms(20);                       // antirrebote

		cli();
		EIFR = (1 << INTF0);                 // limpiar pendiente
		EIMSK |= (1 << INT0);                // (re)habilitar INT0
		sleep_enable();
		sei();
		sleep_cpu();
		sleep_disable();

		// Primera accion observable: PB0 (canal 2 del osciloscopio)
		if (despertar)
		{
			PORTB ^= (1 << PB0);
		}

		_delay_ms(20);                       // antirrebote
		while (!(PIND & (1 << PD2))) {}      // esperar que se suelte

#elif MODO_SLEEP == 1

		cli();
		PORTB |= (1 << PB1);                 // referencia: antes de la conversion
		ADCSRA |= (1 << ADSC);
		sleep_enable();
		sei();
		sleep_cpu();
		sleep_disable();

		if (despertar)
		{
			PORTB ^= (1 << PB0);             // primera accion observable
			PORTB &= ~(1 << PB1);
			_delay_ms(500);
		}

#endif
	}
}
