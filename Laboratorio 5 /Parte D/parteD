#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <avr/sleep.h>
#include <util/delay.h>

// 0 IDLE
// 1 ADC NOISE REDUCTION
// 2 POWER-DOWN

#define MODO_SLEEP 0

volatile uint8_t despertar = 0;

ISR(INT0_vect)
{
	despertar = 1;
}

ISR(ADC_vect)
{
	despertar = 1;
}

int main(void)
{
	// Configurar LED en PB0 como salida
	DDRB |= (1 << PB0);
	PORTB &= ~(1 << PB0);


	for (uint8_t i = 0; i < 6; i++) {  //para que no se bloquee en sleep+
		PORTB ^= (1 << PB0);
		_delay_ms(250);
	}
	PORTB &= ~(1 << PB0); // Apagar LED al terminar la ventana

	#if MODO_SLEEP == 0

	// pd2 entrada con pull up
	DDRD &= ~(1 << PD2);
	PORTD |= (1 << PD2);

	// INT0 por flanco descendente
	EICRA &= ~(1 << ISC00);
	EICRA |= (1 << ISC01);

	EIFR = (1 << INTF0);
	EIMSK |= (1 << INT0);

	set_sleep_mode(SLEEP_MODE_IDLE);

	#elif MODO_SLEEP == 1 //adc noise redution 

	ADMUX = (1 << REFS0); // Referencia AVcc y entrada ADC0 (A0)

	// Habilitar ADC, interrupción y prescaler 128
	ADCSRA = (1 << ADEN) |
	(1 << ADIE) |
	(1 << ADPS2) |
	(1 << ADPS1) |
	(1 << ADPS0);

	set_sleep_mode(SLEEP_MODE_ADC);

	#elif MODO_SLEEP == 2

	// MODO POWER-DOWN
	DDRD &= ~(1 << PD2);
	PORTD |= (1 << PD2);

	// INT0 por nivel bajo
	EICRA &= ~((1 << ISC01) | (1 << ISC00));

	EIFR = (1 << INTF0);
	EIMSK |= (1 << INT0);

	set_sleep_mode(SLEEP_MODE_PWR_DOWN);

	#else
	#error "Seleccion de modo Sleep incorrecta"
	#endif

	sei();

	while (1)
	{
		despertar = 0;

		#if MODO_SLEEP == 0 || MODO_SLEEP == 2
		
		// Esperar a que el pulsador esté presionado (nivel bajo en PD2)
		while (PIND & (1 << PD2))
		{
		}

		_delay_ms(20); // Antirebote

		cli();
		// Limpiar interrupción pendiente
		EIFR = (1 << INTF0);

		sleep_enable();
		sei();
		sleep_cpu();
		sleep_disable();

		// Si despertó por INT0, cambiar estado del LED
		if (despertar)
		{
			PORTB ^= (1 << PB0);
		}

		// Esperar que se suelte el pulsador antes de volver a empezar
		while (!(PIND & (1 << PD2)))
		{
		}

		_delay_ms(20); // Antirebote

		#elif MODO_SLEEP == 1

		// Iniciar conversión ADC
		cli();
		ADCSRA |= (1 << ADSC);
		sleep_enable();
		sei();
		sleep_cpu();
		sleep_disable();

		// Al terminar la conversión, cambiar LED
		if (despertar)
		{
			PORTB ^= (1 << PB0);
			_delay_ms(500);
		}

		#endif
	}
}+++++++++++++++++++
