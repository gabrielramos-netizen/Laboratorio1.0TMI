int main(void)
{
	// PC0 -> DO
	// PC1 -> RE
	// PC2 -> MI
	// PC3 -> FA
	// PC4 -> SOL
	// PC5 -> LA
	// PD2 -> SI
	// PD3 -> DO agudo
	DDRC &= ~((1 << PC0) |
	(1 << PC1) |
	(1 << PC2) |
	(1 << PC3) |
	(1 << PC4) |
	(1 << PC5));

	DDRD &= ~((1 << PD2) |
	(1 << PD3));


	PORTC |= (1 << PC0) |
	(1 << PC1) |
	(1 << PC2) |
	(1 << PC3) |
	(1 << PC4) |
	(1 << PC5);

	PORTD |= (1 << PD2) |
	(1 << PD3);

	//Buzzers
	DDRB |= (1 << PB1);
	PORTB &= ~(1 << PB1);
	
	DDRD |= (1 << PD5);
	PORTD &= ~(1 << PD5);
	//LCD
	DDRB |= (1 << PB0) |
	(1 << PB2) |
	(1 << PB3) |
	(1 << PB4) |
	(1 << PB5);

	DDRD |= (1 << PD4);

	//inicializar lcd
	LCD_inicializar();

	USART_init(9600);

	LCD_texto("PIANO LISTO");

	//principal
	while(1)
	{
		
