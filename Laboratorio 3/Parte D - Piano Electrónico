int main(void)
{
	// PC0 -> DO
	// PC1 -> RE
	// PC2 -> MI
	// PC3 -> FA
	// PD6 -> SOL (antes PC4)
	// PD7 -> LA  (antes PC5)
	// PD2 -> SI
	// PD3 -> DO agudo
	// PC4 -> SDA del LCD I2C
	// PC5 -> SCL del LCD I2C

	DDRC &= ~((1 << PC0) |
	(1 << PC1) |
	(1 << PC2) |
	(1 << PC3));

	DDRD &= ~((1 << PD2) |
	(1 << PD3) |
	(1 << PD6) |
	(1 << PD7));

	PORTC |= (1 << PC0) |
	(1 << PC1) |
	(1 << PC2) |
	(1 << PC3);

	PORTD |= (1 << PD2) |
	(1 << PD3) |
	(1 << PD6) |
	(1 << PD7);

	// Buzzers
	DDRB |= (1 << PB1);
	PORTB &= ~(1 << PB1);

	DDRD |= (1 << PD5);
	PORTD &= ~(1 << PD5);

	// Inicializar LCD I2C
	LCD_inicializar();

	USART_init(9600);

	Timer1_inicializar();

	LCD_texto("PIANO LISTO");

	// Principal
	while (1)
	{
		if (UCSR0A & (1 << RXC0))
		{
			char comando = USART_receive();

			if (comando == 'C' || comando == 'c')
			{
				while (!(UCSR0A & (1 << RXC0)));

				char numero = USART_receive();

				if (numero == '1')
				{
					reproducir_cancion1();
				}
				else if (numero == '2')
				{
					reproducir_cancion2();
				}
				else if (numero == '3')
				{
					reproducir_cancion3();
				}
			}
			else if (comando == 'P' || comando == 'p')
			{
				modo_piano = 1;
				PORTB &= ~(1 << PB1);
				PORTD &= ~(1 << PD5);

				LCD_comando(0x01);
				LCD_texto("MODO PIANO");
			}
		}

		if (modo_piano == 1)
		{
			if (!(PINC & (1 << PC0)))
			{
				LCD_comando(0x01);
				LCD_texto("DO");
				tocar_nota(1908);
			}
			else if (!(PINC & (1 << PC1)))
			{
				LCD_comando(0x01);
				LCD_texto("RE");
				tocar_nota(1701);
			}
			else if (!(PINC & (1 << PC2)))
			{
				tocar_nota(1515);
				LCD_comando(0x01);
				LCD_texto("MI");
			}
			else if (!(PINC & (1 << PC3)))
			{
				tocar_nota(1433);
				LCD_comando(0x01);
				LCD_texto("FA");
			}
			else if (!(PIND & (1 << PD6)))
			{
				tocar_nota(1276);
				LCD_comando(0x01);
				LCD_texto("SOL");
			}
			else if (!(PIND & (1 << PD7)))
			{
				tocar_nota(1136);
				LCD_comando(0x01);
				LCD_texto("LA");
			}
			else if (!(PIND & (1 << PD2)))
			{
				tocar_nota(1012);
				LCD_comando(0x01);
				LCD_texto("SI");
			}
			else if (!(PIND & (1 << PD3)))
			{
				tocar_nota(956);
				LCD_comando(0x01);
				LCD_texto("DO");
			}
			else
			{
				PORTB &= ~(1 << PB1);
			}
		}
	}

	return 0;
}

void tocar_nota(unsigned int tiempo)
{
	PORTB |= (1 << PB1);
	delay_us_var(tiempo);
	PORTB &= ~(1 << PB1);
	delay_us_var(tiempo);
}

void tocar_durante(unsigned int periodo, unsigned int duracion_ms)
{
	unsigned long ciclos =
	((unsigned long)duracion_ms * 1000UL) /
	(2UL * periodo);

	for (unsigned long i = 0; i < ciclos; i++)
	{
		tocar_nota(periodo);
	}
}

void tocar_dos_notas(unsigned int periodo1, unsigned int periodo2, unsigned int duracion_ms)
{
	sonido_activo = 0;

	PORTB &= ~(1 << PB1);
	PORTD &= ~(1 << PD5);

	contador_buzzer1 = 0;
	contador_buzzer2 = 0;

	// Convertir los periodos en microsegundos
	// a intervalos de 50 us del Timer1
	periodo_buzzer1 = (periodo1 + 25U) / 50U;
	periodo_buzzer2 = (periodo2 + 25U) / 50U;

	detener_cancion = 0;
	sonido_activo = 1;

	for (unsigned int i = 0; i < duracion_ms; i++)
	{
		if (UCSR0A & (1 << RXC0))
		{
			char comando = USART_receive();

			if (comando == 'P' || comando == 'p')
			{
				detener_cancion = 1;
				break;
			}
		}

		_delay_ms(1);
	}

	sonido_activo = 0;

	PORTB &= ~(1 << PB1);
	PORTD &= ~(1 << PD5);
}

// ================= LCD POR I2C =================

void TWI_inicializar(void)
{
	// Frecuencia I2C de 100 kHz con F_CPU = 16 MHz
	TWSR = 0x00;
	TWBR = 72;
	TWCR = (1 << TWEN);
}

void TWI_escribir(unsigned char dato)
{
	// Generar condicion START
	TWCR = (1 << TWINT) | (1 << TWSTA) | (1 << TWEN);
	while (!(TWCR & (1 << TWINT)));

	// Direccion I2C 0x27 en modo escritura
	TWDR = 0x4E;
	TWCR = (1 << TWINT) | (1 << TWEN);
	while (!(TWCR & (1 << TWINT)));

	// Enviar dato al adaptador
	TWDR = dato;
	TWCR = (1 << TWINT) | (1 << TWEN);
	while (!(TWCR & (1 << TWINT)));

	// Generar condicion STOP
	TWCR = (1 << TWINT) | (1 << TWSTO) | (1 << TWEN);

	_delay_us(10);
}

void LCD_enviar_nibble(unsigned char datos, unsigned char rs)
{
	// PCF8574:
	// P0 = RS, P1 = RW, P2 = Enable, P3 = luz de fondo
	// P4-P7 = datos del LCD

	unsigned char salida = (datos << 4) | 0x08;

	if (rs)
	{
		salida |= 0x01;
	}

	// Activar Enable
	TWI_escribir(salida | 0x04);
	_delay_us(1);

	// Desactivar Enable
	TWI_escribir(salida);
	_delay_us(50);
}

void LCD_enviar_byte(unsigned char dato, unsigned char rs)
{
	LCD_enviar_nibble(dato >> 4, rs);
	LCD_enviar_nibble(dato & 0x0F, rs);
}

void LCD_comando(unsigned char comando)
{
	LCD_enviar_byte(comando, 0);

	if (comando == 0x01 || comando == 0x02)
	{
		_delay_ms(2);
	}
}

void LCD_caracter(char caracter)
{
	LCD_enviar_byte((unsigned char)caracter, 1);
}

void LCD_texto(const char *texto)
{
	while (*texto)
	{
		LCD_caracter(*texto);
		texto++;
	}
}

void LCD_inicializar(void)
{
	TWI_inicializar();

	_delay_ms(50);

	// Inicializacion del LCD en modo de 4 bits
	LCD_enviar_nibble(0x03, 0);
	_delay_ms(5);

	LCD_enviar_nibble(0x03, 0);
	_delay_us(150);

	LCD_enviar_nibble(0x03, 0);
	_delay_us(150);

	LCD_enviar_nibble(0x02, 0);
	_delay_us(150);

	LCD_comando(0x28); // 2 lineas, modo de 4 bits
	LCD_comando(0x0C); // Pantalla encendida, cursor apagado
	LCD_comando(0x01); // Limpiar pantalla
	LCD_comando(0x06); // Avanzar cursor
}

// ================= COMUNICACION USART =================

void USART_init(unsigned int baud)
{
	unsigned int ubrr = F_CPU / 16 / baud - 1;

	UBRR0H = (unsigned char)(ubrr >> 8);
	UBRR0L = (unsigned char)ubrr;

	UCSR0B = (1 << RXEN0) | (1 << TXEN0);
	UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

void USART_transmit(unsigned char dato)
{
	while (!(UCSR0A & (1 << UDRE0)));

	UDR0 = dato;
}

unsigned char USART_receive(void)
{
	while (!(UCSR0A & (1 << RXC0)));

	return UDR0;
}

void USART_sendString(const char *texto)
{
	while (*texto)
	{
		USART_transmit(*texto);
		texto++;
	}
}

// ================= REPRODUCCION DE CANCIONES =================

void reproducir(const uint8_t *cancion,
const uint8_t *bajo,
uint8_t cantidad)
{
	modo_piano = 0;
	detener_cancion = 0;

	for (uint8_t i = 0; i < cantidad; i++)
	{
		unsigned int periodo1 = 0;
		unsigned int periodo2 = 0;

		// Obtener la nota de la melodia
		if (cancion[i] < 8)
		{
			periodo1 = notas_melodia[cancion[i]];
		}

		// Obtener la nota del acompanamiento
		if (bajo[i] < 8)
		{
			periodo2 = notas_melodia[bajo[i]] * 2U;
		}

		tocar_dos_notas(periodo1, periodo2, 300);

		if (detener_cancion)
		{
			break;
		}

		_delay_ms(40);
	}

	sonido_activo = 0;

	PORTB &= ~(1 << PB1);
	PORTD &= ~(1 << PD5);

	modo_piano = 1;

	LCD_comando(0x01);
	LCD_texto("MODO PIANO");
}

void reproducir_cancion1(void)
{
	LCD_comando(0x01);
	LCD_texto("SEVEN NATION");

	reproducir(cancion1, bajo1, sizeof(cancion1));
}

void reproducir_cancion2(void)
{
	LCD_comando(0x01);
	LCD_texto("SHAPE OF YOU");

	reproducir(cancion2, bajo2, sizeof(cancion2));
}

void reproducir_cancion3(void)
{
	LCD_comando(0x01);
	LCD_texto("BAD ROMANCE");

	reproducir(cancion3, bajo3, sizeof(cancion3));
}

void delay_us_var(unsigned int us)
{
	while (us > 0)
	{
		_delay_us(1);
		us--;
	}
}

// ================= TIMER1 =================

void Timer1_inicializar(void)
{
	TCCR1A = 0;
	TCCR1B = 0;

	TCNT1 = 0;
	OCR1A = 99;

	// Modo CTC
	TCCR1B |= (1 << WGM12);

	// Prescaler de 8
	TCCR1B |= (1 << CS11);

	// Habilitar interrupcion por comparacion
	TIMSK1 |= (1 << OCIE1A);

	sei();
}

ISR(TIMER1_COMPA_vect)
{
	if (!sonido_activo)
	return;

	if (periodo_buzzer1 > 0)
	{
		contador_buzzer1++;

		if (contador_buzzer1 >= periodo_buzzer1)
		{
			contador_buzzer1 = 0;
			PORTB ^= (1 << PB1);
		}
	}

	if (periodo_buzzer2 > 0)
	{
		contador_buzzer2++;

		if (contador_buzzer2 >= periodo_buzzer2)
		{
			contador_buzzer2 = 0;
			PORTD ^= (1 << PD5);
		}
	}
}
