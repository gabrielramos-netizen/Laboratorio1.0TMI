				}
			}
			else if (comando == 'P' || comando == 'p')
			{
				modo_piano = 1;
				PORTB &= ~(1 << PB1);
				PORTD &= ~(1 << PD5);
				
				LCD_comando(0x01);
				LCD_texto("MODO PIANO");
			}
		}

		
		
		if (modo_piano == 1)
		{
			if (!(PINC & (1 << PC0))) {
				LCD_comando(0x01);
				LCD_texto("DO");
				tocar_nota(1908);
			}
			else if (!(PINC & (1 << PC1)))
			{
				LCD_comando(0x01);
				LCD_texto("RE");
				tocar_nota(1701);//re
			}
			else if (!(PINC & (1 << PC2)))
			{
				tocar_nota(1515);//mi
				LCD_comando(0x01);
				LCD_texto("MI");
			}
			else if (!(PINC & (1 << PC3)))
			{
				tocar_nota(1433);//fa
				LCD_comando(0x01);
				LCD_texto("FA");
			}
			else if (!(PINC & (1 << PC4)))
			{
				tocar_nota(1276);//sol
				LCD_comando(0x01);
				LCD_texto("SOL");
				
			}
			else if (!(PINC & (1 << PC5)))
			{
				tocar_nota(1136);//la
				LCD_comando(0x01);
				LCD_texto("LA");
			}
			else if (!(PIND & (1 << PD2)))
			{
				tocar_nota(1012);//si
				LCD_comando(0x01);
				LCD_texto("SI");
			}
			else if (!(PIND & (1 << PD3)))
			{
				tocar_nota(956);//do_Agudo
				LCD_comando(0x01);
				LCD_texto("DO");
			}
			
			else {
				PORTB &= ~(1 << PB1);//ningun boton presionado
			}
		}
	}

	return 0;
}

void tocar_nota(unsigned int tiempo) {
	PORTB |= (1 << PB1);
	delay_us_var(tiempo);
	PORTB &= ~(1 << PB1);
	delay_us_var(tiempo);
}

void tocar_durante(unsigned int periodo, unsigned int duracion_ms)
{
	unsigned long ciclos =
	((unsigned long)duracion_ms * 1000UL) /
	(2UL * periodo);

	for (unsigned long i = 0; i < ciclos; i++)
	{
		tocar_nota(periodo);
	}
}

void tocar_dos_notas(unsigned int periodo1, unsigned int periodo2, unsigned int duracion_ms)
{
	unsigned long tiempo1 = 0;
	unsigned long tiempo2 = 0;

	unsigned long total =
	(unsigned long)duracion_ms * 1000UL;

	uint8_t estado1 = 0;
	uint8_t estado2 = 0;

	PORTB &= ~(1 << PB1);
	PORTD &= ~(1 << PD5);

	detener_cancion = 0;

	for (unsigned long tiempo = 0;
	tiempo < total;
	tiempo += 50)
	{
		// Revisar si se recibio el comando para detener
		if (UCSR0A & (1 << RXC0))
		{
			char comando = USART_receive();

			if (comando == 'P' || comando == 'p')
			{
				detener_cancion = 1;
				break;
			}
		}

		// Generar la melodia en el primer buzzer
		if (periodo1 > 0)
		{
			tiempo1 += 50;

			if (tiempo1 >= periodo1)
			{
				tiempo1 = 0;
				estado1 = !estado1;

				if (estado1)
				PORTB |= (1 << PB1);
				else
				PORTB &= ~(1 << PB1);
			}
		}

		// Generar el bajo en el segundo buzzer
		if (periodo2 > 0)
		{
			tiempo2 += 50;

			if (tiempo2 >= periodo2)
			{
				tiempo2 = 0;
				estado2 = !estado2;

				if (estado2)
				PORTD |= (1 << PD5);
				else
				PORTD &= ~(1 << PD5);
			}
		}

		_delay_us(50);
	}

	PORTB &= ~(1 << PB1);
	PORTD &= ~(1 << PD5);
}

void LCD_nibble(unsigned char datos) {
	if (datos & 0x01) PORTB |= (1 << PB3);
	else PORTB &= ~(1 << PB3);
	if (datos & 0x02) PORTB |= (1 << PB4);
	else PORTB &= ~(1 << PB4);
	if (datos & 0x04) PORTB |= (1 << PB5);
	else PORTB &= ~(1 << PB5);
	if (datos & 0x08) PORTD |= (1 << PD4);
	else PORTD &= ~(1 << PD4);
	PORTB |= (1 << PB2);
	_delay_us(1);
	PORTB &= ~(1 << PB2);
	_delay_us(100);

}

void LCD_comando(unsigned char comando) {
	PORTB &= ~(1 << PB0);
	LCD_nibble(comando >> 4);
	LCD_nibble(comando & 0x0F);
	_delay_ms(2);

}

void LCD_caracter(char caracter) {
	PORTB |= (1 << PB0);
	LCD_nibble(caracter >> 4);
	LCD_nibble(caracter & 0x0F);
	_delay_us(100);

}

void LCD_texto(const char *texto) {
	while (*texto) {
		LCD_caracter(*texto);
		texto++;
	}

}
void LCD_inicializar(void) {
	_delay_ms(20);
	LCD_nibble(0x03);
	_delay_ms(5);
	LCD_nibble(0x03);
	_delay_us(150);
	LCD_nibble(0x03);
	LCD_nibble(0x02);
	LCD_comando(0x28);
	LCD_comando(0x0C);
	LCD_comando(0x01);
	_delay_ms(2);
}

void USART_init(unsigned int baud)
{
	unsigned int ubrr = F_CPU / 16 / baud - 1;

	UBRR0H = (unsigned char)(ubrr >> 8);
	UBRR0L = (unsigned char)ubrr;

	UCSR0B = (1 << RXEN0) | (1 << TXEN0);
	UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

void USART_transmit(unsigned char dato)
{
	while (!(UCSR0A & (1 << UDRE0)));

	UDR0 = dato;
}

unsigned char USART_receive(void)
{
	while (!(UCSR0A & (1 << RXC0)));
	return UDR0;
}

void USART_sendString(const char *texto)
{
	while (*texto)
	{
		USART_transmit(*texto);
		texto++;
	}
}

void reproducir(const uint8_t *cancion, const uint8_t *bajo, uint8_t cantidad)
{
	modo_piano = 0;

	for (uint8_t i = 0; i < cantidad; i++)
	{
		tocar_dos_notas(
		notas_melodia[cancion[i]],
		notas_melodia[bajo[i]] * 2U,
		300
		);

		if (detener_cancion)
		break;

		_delay_ms(40);
	}

	PORTB &= ~(1 << PB1);
	PORTD &= ~(1 << PD5);

	modo_piano = 1;

	LCD_comando(0x01);
	LCD_texto("MODO PIANO");
}
