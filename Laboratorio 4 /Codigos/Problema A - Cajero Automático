#define F_CPU 16000000UL

// Direccion I2C de ejemplo del expansor PCF8574.
// Si la pantalla no responde, verificar si usa 0x27 o 0x3F.
#define PCF8574 0x27

#include <avr/io.h>
#include <avr/eeprom.h>
#include <util/delay.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>

#include "SPI.h"
#include "UART.h"
#include "RC522.h"
#include "TWI_LCD.H"


/* 
   CONFIGURACION DE CUENTAS Y EEPROM
    */

#define NUM_CUENTAS 3
#define SALDO_INICIAL 1000
#define MARCA_VALIDACION 0xA5

typedef struct
{
    uint8_t uid[4];
    uint8_t pin[4];
    uint16_t saldo;
} Cuenta;

Cuenta cuentas[NUM_CUENTAS];

Cuenta EEMEM cuentas_eeprom[NUM_CUENTAS];
uint8_t EEMEM marca_eeprom;
/* 

   PINES

   Teclado:
   Filas    PC0, PC1, PC2, PC3
   Columnas PD2, PD3, PD4, PD5

   LED verde: PB0
   LED rojo:  PD6
   Buzzer:    PD7

   UART:      PD0 y PD1
   RC522:     PB1 a PB5
   LCD I2C:   PC4 y PC5
   */

const char mapa_teclado[4][4] =
{
    {'1', '2', '3', 'A'},
    {'4', '5', '6', 'B'},
    {'7', '8', '9', 'C'},
    {'*', '0', '#', 'D'}
};


/*
   FUNCIONES DE LCD
 */

void lcd_posicion(uint8_t fila, uint8_t columna)
{
    if (fila == 0)
        twi_lcd_cmd(0x80 + columna);
    else
        twi_lcd_cmd(0xC0 + columna);
}

void lcd_linea(uint8_t fila, const char *texto)
{
    uint8_t i = 0;

    lcd_posicion(fila, 0);

    while (texto[i] != '\0' && i < 16)
    {
        twi_lcd_dwr(texto[i]);
        i++;
    }

    while (i < 16)
    {
        twi_lcd_dwr(' ');
        i++;
    }
}

void lcd_mensaje(const char *linea1, const char *linea2)
{
    lcd_linea(0, linea1);
    lcd_linea(1, linea2);
}


/* 
   TECLADO 4x4
 */

void teclado_inicializar(void)
{
    // PC0-PC3 como salidas para las filas.
    // Se preservan PC4-PC7, incluidos SDA y SCL.
    DDRC = (DDRC & 0xF0) | 0x0F;
    PORTC = (PORTC & 0xF0) | 0x0F;

    // PD2-PD5 como entradas con pull-up.
    DDRD &= ~0x3C;
    PORTD |= 0x3C;
}

char teclado_escanear(void)
{
    for (uint8_t fila = 0; fila < 4; fila++)
    {
        // Todas las filas quedan inicialmente en alto.
        PORTC = (PORTC & 0xF0) | 0x0F;

        // Activar una fila llevandola a nivel bajo.
        PORTC &= ~(1 << fila);

        _delay_us(5);

        for (uint8_t columna = 0; columna < 4; columna++)
        {
            if (!(PIND & (1 << (PD2 + columna))))
            {
                return mapa_teclado[fila][columna];
            }
        }
    }

    return 0;
}

char teclado_leer(void)
{
    char tecla = 0;

    while (tecla == 0)
    {
        tecla = teclado_escanear();
        _delay_ms(15);
    }

    // Antirrebote y espera a que se suelte la tecla.
    _delay_ms(20);

    while (teclado_escanear() != 0)
    {
        _delay_ms(10);
    }

    return tecla;
}


/* 
   LEDS Y BUZZER
    */

void indicadores_inicializar(void)
{
    DDRB |= (1 << PB0);
    PORTB &= ~(1 << PB0);

    DDRD |= (1 << PD6) | (1 << PD7);
    PORTD &= ~((1 << PD6) | (1 << PD7));
}

void buzzer_tono(uint16_t duracion_ms)
{
    // Aproximadamente 2 kHz para un buzzer pasivo.
    for (uint32_t i = 0; i < (uint32_t)duracion_ms * 4; i++)
    {
        PORTD ^= (1 << PD7);
        _delay_us(250);
    }

    PORTD &= ~(1 << PD7);
}

void indicar_exito(void)
{
    PORTB |= (1 << PB0);
    buzzer_tono(70);
    PORTB &= ~(1 << PB0);
}

void indicar_error(void)
{
    PORTD |= (1 << PD6);
    buzzer_tono(150);
    PORTD &= ~(1 << PD6);
}

void indicar_bloqueo(void)
{
    PORTD |= (1 << PD6);
    buzzer_tono(1500);
    PORTD &= ~(1 << PD6);
}

/* 
   LECTOR RFID
    */

uint8_t leer_uid(uint8_t uid[4])
{
    // La libreria del profesor puede escribir hasta 16 bytes
    // al producirse una lectura o un timeout.
    uint8_t datos[16] = {0};

    mfrc522_standard(datos);

    uint8_t hay_datos = 0;

    for (uint8_t i = 0; i < 4; i++)
    {
        uid[i] = datos[i];

        if (datos[i] != 0)
            hay_datos = 1;
    }

    return hay_datos;
}

uint8_t uid_igual(const uint8_t a[4], const uint8_t b[4])
{
    for (uint8_t i = 0; i < 4; i++)
    {
        if (a[i] != b[i])
            return 0;
    }

    return 1;
}

int8_t buscar_cuenta(const uint8_t uid[4])
{
    for (uint8_t i = 0; i < NUM_CUENTAS; i++)
    {
        if (uid_igual(uid, cuentas[i].uid))
            return (int8_t)i;
    }

    return -1;
}

void esperar_retirar_tarjeta(void)
{
    uint8_t uid[4];

    lcd_mensaje("Retire tarjeta", "Por favor");

    while (leer_uid(uid))
    {
        _delay_ms(200);
    }

    _delay_ms(300);
}


/* 
   TECLADO: PIN Y MONTO
    */

void leer_pin(uint8_t pin[4])
{
    uint8_t cantidad = 0;
    char texto[17];

    lcd_mensaje("Ingrese PIN", "");

    while (cantidad < 4)
    {
        char tecla = teclado_leer();

        if (tecla >= '0' && tecla <= '9')
        {
            pin[cantidad] = tecla - '0';
            cantidad++;
        }
        else if (tecla == '*')
        {
            cantidad = 0;
        }

        strcpy(texto, "PIN: ");

        for (uint8_t i = 0; i < cantidad; i++)
            texto[5 + i] = '*';

        texto[5 + cantidad] = '\0';

        lcd_linea(1, texto);
    }
}

uint8_t pin_correcto(uint8_t ingresado[4], uint8_t guardado[4])
{
    for (uint8_t i = 0; i < 4; i++)
    {
        if (ingresado[i] != guardado[i])
            return 0;
    }

    return 1;
}

uint16_t leer_monto(void)
{
    char buffer[6] = "";
    uint8_t cantidad = 0;

    lcd_mensaje("Monto #=OK *=BOR", "");

    while (1)
    {
        char tecla = teclado_leer();

        if (tecla >= '0' && tecla <= '9' && cantidad < 5)
        {
            buffer[cantidad] = tecla;
            cantidad++;
            buffer[cantidad] = '\0';
        }
        else if (tecla == '*')
        {
            if (cantidad > 0)
            {
                cantidad--;
                buffer[cantidad] = '\0';
            }
        }
        else if (tecla == '#')
        {
            if (cantidad == 0)
                return 0;

            uint32_t valor = 0;

            for (uint8_t i = 0; i < cantidad; i++)
            {
                valor = valor * 10 + (buffer[i] - '0');
            }

            if (valor > 65535UL)
                return 0;

            return (uint16_t)valor;
        }

        lcd_linea(1, buffer);
    }
}

/* 
   ALMACENAMIENTO PERSISTENTE
    */

void guardar_cuenta(uint8_t indice)
{
    eeprom_update_block(
        &cuentas[indice],
        &cuentas_eeprom[indice],
        sizeof(Cuenta)
    );
}

void cargar_cuentas(void)
{
    eeprom_read_block(
        cuentas,
        cuentas_eeprom,
        sizeof(cuentas)
    );
}

uint8_t uid_duplicado(const uint8_t uid[4], uint8_t cantidad)
{
    for (uint8_t i = 0; i < cantidad; i++)
    {
        if (uid_igual(uid, cuentas[i].uid))
            return 1;
    }

    return 0;
}

/* 
   REGISTRO INICIAL DE LAS TRES CUENTAS
    */

void configurar_cuentas(void)
{
    uint8_t uid[4];
    uint8_t pin[4];

    for (uint8_t i = 0; i < NUM_CUENTAS; i++)
    {
        char linea[17];

        snprintf(linea, sizeof(linea), "Registrar %u/3", i + 1);

        while (1)
        {
            lcd_mensaje(linea, "Acerque tarjeta");

            while (!leer_uid(uid))
            {
                _delay_ms(200);
            }

            if (uid_duplicado(uid, i))
            {
                lcd_mensaje("Tarjeta repetida", "Use otra tarjeta");
                indicar_error();
                esperar_retirar_tarjeta();
                continue;
            }

            esperar_retirar_tarjeta();
            break;
        }

        for (uint8_t j = 0; j < 4; j++)
            cuentas[i].uid[j] = uid[j];

        lcd_mensaje("Defina PIN", "Use 4 digitos");
        leer_pin(pin);

        for (uint8_t j = 0; j < 4; j++)
            cuentas[i].pin[j] = pin[j];

        cuentas[i].saldo = SALDO_INICIAL;

        guardar_cuenta(i);

        lcd_mensaje("Cuenta guardada", "Correctamente");
        indicar_exito();
        _delay_ms(1000);
    }

    // Se escribe la marca al final, una vez registradas
    // las tres cuentas.
    eeprom_update_byte(&marca_eeprom, MARCA_VALIDACION);

    lcd_mensaje("Registro listo", "Cajero iniciado");
    _delay_ms(1500);
}

/* 
   AUTENTICACION
    */

uint8_t autenticar(uint8_t indice)
{
    uint8_t ingresado[4];

    for (uint8_t intento = 0; intento < 3; intento++)
    {
        char linea[17];

        snprintf(linea, sizeof(linea), "Intento %u de 3", intento + 1);
        lcd_mensaje(linea, "Ingrese PIN");

        leer_pin(ingresado);

        if (pin_correcto(ingresado, cuentas[indice].pin))
        {
            lcd_mensaje("PIN correcto", "Bienvenido");
            indicar_exito();
            _delay_ms(1000);
            return 1;
        }

        lcd_mensaje("PIN incorrecto", "Intente otra vez");
        indicar_error();
        _delay_ms(1000);
    }

    lcd_mensaje("Acceso bloqueado", "3 errores PIN");
    indicar_bloqueo();
    _delay_ms(1000);

    return 0;
}


/* 
   OPERACIONES BANCARIAS
    */

void consultar_saldo(uint8_t indice)
{
    char linea[17];

    snprintf(linea, sizeof(linea), "Saldo: %u", cuentas[indice].saldo);

    lcd_mensaje("Saldo disponible", linea);
    _delay_ms(2000);
}

void depositar(uint8_t indice)
{
    uint16_t monto = leer_monto();

    if (monto == 0)
    {
        lcd_mensaje("Monto invalido", "Operacion cancel.");
        indicar_error();
        _delay_ms(1200);
        return;
    }

    uint32_t nuevo_saldo = (uint32_t)cuentas[indice].saldo + monto;

    if (nuevo_saldo > 65535UL)
    {
        lcd_mensaje("Monto excesivo", "No se deposito");
        indicar_error();
        _delay_ms(1200);
        return;
    }

    cuentas[indice].saldo = (uint16_t)nuevo_saldo;
    guardar_cuenta(indice);

    lcd_mensaje("Deposito correcto", "Saldo actualizado");
    indicar_exito();
    _delay_ms(1500);
}

void retirar(uint8_t indice)
{
    uint16_t monto = leer_monto();

    if (monto == 0)
    {
        lcd_mensaje("Monto invalido", "Operacion cancel.");
        indicar_error();
        _delay_ms(1200);
        return;
    }

    if (monto > cuentas[indice].saldo)
    {
        lcd_mensaje("Saldo insufic.", "Retiro rechazado");
        indicar_error();
        _delay_ms(1500);
        return;
    }

    cuentas[indice].saldo -= monto;
    guardar_cuenta(indice);

    lcd_mensaje("Retiro correcto", "Saldo actualizado");
    indicar_exito();
    _delay_ms(1500);
}


/* 
   MENU PRINCIPAL DE LA CUENTA
    */

void menu_cuenta(uint8_t indice)
{
    uint8_t salir = 0;

    while (!salir)
    {
        lcd_mensaje("A:Saldo B:Retiro", "C:Deposito D:Fin");

        char tecla = teclado_leer();

        switch (tecla)
        {
            case 'A':
                consultar_saldo(indice);
                break;

            case 'B':
                retirar(indice);
                break;

            case 'C':
                depositar(indice);
                break;

            case 'D':
                salir = 1;
                lcd_mensaje("Sesion finalizada", "Retire tarjeta");
                _delay_ms(1000);
                break;

            default:
                break;
        }
    }
}


/* 
   PROGRAMA PRINCIPAL
    */

int main(void)
{
    uint8_t uid[4];

    // Inicializar UART a 9600 baudios.
    uart_init(103);

    // Inicializar SPI y seleccionar el RC522.
    spi_init();

    DDRB |= (1 << PB2);
    PORTB |= (1 << PB2);

    mfrc522_resetPinInit();
    mfrc522_init();

    // Inicializar TWI y LCD.
    twi_init();
    twi_lcd_init();

    // Configurar teclado e indicadores DESPUES de inicializar
    // la pantalla, para configurar PC0-PC3 como filas.
    teclado_inicializar();
    indicadores_inicializar();

    lcd_mensaje("Cajero automatico", "Iniciando...");
    _delay_ms(1000);

    // Comprobar si ya se registraron las cuentas.
    if (eeprom_read_byte(&marca_eeprom) != MARCA_VALIDACION)
    {
        configurar_cuentas();
    }
    else
    {
        cargar_cuentas();
        lcd_mensaje("Cuentas cargadas", "Acerque tarjeta");
        _delay_ms(1200);
    }

    while (1)
    {
        int8_t indice;

        lcd_mensaje("Cajero listo", "Acerque tarjeta");

        // Esperar una tarjeta RFID.
        while (!leer_uid(uid))
        {
            _delay_ms(200);
        }

        // Buscar la cuenta asociada al UID.
        indice = buscar_cuenta(uid);

        if (indice < 0)
        {
            lcd_mensaje("Tarjeta no valida", "Acceso denegado");
            indicar_error();
            _delay_ms(1200);
            esperar_retirar_tarjeta();
            continue;
        }

        lcd_mensaje("Tarjeta valida", "Retire tarjeta");
        esperar_retirar_tarjeta();

        // Solicitar PIN y permitir hasta tres intentos.
        if (!autenticar((uint8_t)indice))
        {
            esperar_retirar_tarjeta();
            continue;
        }

        // Entrar al menu de operaciones.
        menu_cuenta((uint8_t)indice);

        // Evitar iniciar otra sesion con la misma tarjeta
        // si el usuario no la ha retirado.
        esperar_retirar_tarjeta();
    }
}
